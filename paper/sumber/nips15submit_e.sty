% nips15submit_e.sty
% -----------------------------------------------------------------------------
% Reimplementasi gaya NIPS 2015 (LaTeX2e) untuk lingkungan tanpa akses ke berkas
% resmi nips15submit_e.sty. Seluruh parameter di bawah mengikuti spesifikasi yang
% tertulis pada "Formatting Instructions for NIPS 2015":
%
%   - blok teks 5,5 inci x 9 inci, margin kiri 1,5 inci, halaman mulai 1 inci
%     dari tepi atas;
%   - huruf 10 pt dengan jarak baris 11 pt, Times New Roman;
%   - paragraf dipisah setengah baris tanpa indentasi;
%   - judul 17 pt tebal, initial caps, di antara dua garis horizontal
%     (atas 4 pt, bawah 1 pt) dengan jarak 1/4 inci ke judul;
%   - abstrak menjorok 1/2 inci (3 pica) di kedua sisi, kata "Abstract"
%     terpusat, tebal, 12 pt;
%   - heading level 1 tebal 12 pt, level 2 dan 3 tebal 10 pt, seluruhnya rata
%     kiri dan huruf kecil kecuali kata pertama dan nama diri;
%   - halaman diberi nomor.
%
% Perintah \nipsfinalcopy disediakan sebagai no-op agar berkas .tex yang memakai
% shell resmi tetap dapat dikompilasi tanpa perubahan.
% -----------------------------------------------------------------------------

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{nips15submit_e}[2026/08/07 v1.0 NIPS 2015 style (reimplementation)]

% ----------------------------------------------------------------- tata halaman
\setlength{\paperwidth}{8.5in}
\setlength{\paperheight}{11in}
\special{papersize=8.5in,11in}

\setlength{\hoffset}{0in}
\setlength{\voffset}{0in}
\setlength{\oddsidemargin}{0.5in}   % 1in + 0.5in = margin kiri 1,5 inci
\setlength{\evensidemargin}{0.5in}
\setlength{\topmargin}{0in}         % 1in + 0in + 0 + 0 = teks mulai 1 inci
\setlength{\headheight}{0pt}
\setlength{\headsep}{0pt}
\setlength{\textwidth}{5.5in}
\setlength{\textheight}{9in}
\setlength{\footskip}{0.4in}
\setlength{\marginparwidth}{0.5in}
\setlength{\marginparsep}{0.1in}

% ------------------------------------------------------------- ukuran huruf 10/11
\renewcommand{\normalsize}{%
  \@setfontsize\normalsize\@xpt{11}%
  \abovedisplayskip 7\p@ \@plus 2\p@ \@minus 5\p@
  \abovedisplayshortskip \z@ \@plus 3\p@
  \belowdisplayskip \abovedisplayskip
  \belowdisplayshortskip 4\p@ \@plus 3\p@ \@minus 3\p@
}
\renewcommand{\small}{%
  \@setfontsize\small\@ixpt{10}%
  \abovedisplayskip 6\p@ \@plus 1.5\p@ \@minus 4\p@
  \abovedisplayshortskip \z@ \@plus 2\p@
  \belowdisplayskip \abovedisplayskip
  \belowdisplayshortskip 3\p@ \@plus 2\p@ \@minus 2\p@
}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize\@ixpt{10}}
\renewcommand{\scriptsize}{\@setfontsize\scriptsize\@viipt{8}}
\renewcommand{\tiny}{\@setfontsize\tiny\@vpt{6}}
\renewcommand{\large}{\@setfontsize\large\@xiipt{14}}
\renewcommand{\Large}{\@setfontsize\Large\@xivpt{18}}
\renewcommand{\LARGE}{\@setfontsize\LARGE\@xviipt{22}}
\renewcommand{\huge}{\@setfontsize\huge\@xxpt{25}}
\renewcommand{\Huge}{\@setfontsize\Huge\@xxvpt{30}}
\normalsize

% ------------------------------------------------------------------ paragraf
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt \@plus 1pt \@minus 1pt}

% ------------------------------------------------------------------- heading
% satu baris = 11 pt, setengah baris = 5,5 pt
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {11\p@ \@plus 3\p@ \@minus 2\p@}%
  {5.5\p@ \@plus 1\p@}%
  {\normalfont\large\bfseries\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {11\p@ \@plus 3\p@ \@minus 2\p@}%
  {5.5\p@ \@plus 1\p@}%
  {\normalfont\normalsize\bfseries\raggedright}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {11\p@ \@plus 3\p@ \@minus 2\p@}%
  {5.5\p@ \@plus 1\p@}%
  {\normalfont\normalsize\bfseries\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {5.5\p@ \@plus 1\p@}{-0.5em}%
  {\normalfont\normalsize\bfseries}}

% --------------------------------------------------------------- caption kecil
\long\def\@makecaption#1#2{%
  \vskip\abovecaptionskip
  \sbox\@tempboxa{\small #1: #2}%
  \ifdim\wd\@tempboxa >\hsize
    {\small #1: #2\par}%
  \else
    \global\@minipagefalse
    \hb@xt@\hsize{\hfil\box\@tempboxa\hfil}%
  \fi
  \vskip\belowcaptionskip}
\setlength{\abovecaptionskip}{\baselineskip}
\setlength{\belowcaptionskip}{0pt}

% ------------------------------------------------------------------ penulis
\newlength{\@nipsauthorsep}
\setlength{\@nipsauthorsep}{1.5em}
\def\And{\end{tabular}\hskip\@nipsauthorsep\begin{tabular}[t]{c}\bf\ignorespaces}
\def\AND{\end{tabular}\vskip 0.6\baselineskip\begin{tabular}[t]{c}\bf\ignorespaces}

% -------------------------------------------------------------------- judul
\def\@maketitle{%
  \vbox{%
    \hsize\textwidth
    \linewidth\hsize
    \rule{\linewidth}{4pt}%
    \vskip 0.25in
    {\centering\LARGE\bf\@title\par}%
    \vskip 0.25in
    \rule{\linewidth}{1pt}%
    \vskip 0.3in
    {\centering
      \begin{tabular}[t]{c}\bf\@author\end{tabular}%
      \par}%
    \vskip 0.25in
  }%
}
\renewcommand{\maketitle}{%
  \par
  \begingroup
    \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
    \@maketitle
    \@thanks
  \endgroup
  \setcounter{footnote}{0}%
  \global\let\thanks\relax
  \global\let\maketitle\relax
  \global\let\@maketitle\relax
  \global\let\@thanks\@empty
  \global\let\@author\@empty
  \global\let\@title\@empty
  \global\let\title\relax
  \global\let\author\relax
  \global\let\and\relax
}

% ------------------------------------------------------------------- abstrak
\providecommand{\abstractname}{Abstract}
\renewenvironment{abstract}{%
  \vskip 2\baselineskip
  \centerline{\large\bf\abstractname}%
  \vskip 0.5\baselineskip
  \begingroup\small
  \leftskip=0.5in \rightskip=0.5in
}{%
  \par\endgroup
  \vskip 0.5\baselineskip
}

% ------------------------------------------------------------------ lain-lain
\pagestyle{plain}
\providecommand{\nipsfinalcopy}{\relax}

\endinput
